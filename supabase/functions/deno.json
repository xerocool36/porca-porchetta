{
  "imports": {
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.45.4"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-await-in-loop", "eqeqeq"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "check": "deno check porca-availability/index.ts porca-book/index.ts porca-cancel/index.ts porca-admin/index.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
